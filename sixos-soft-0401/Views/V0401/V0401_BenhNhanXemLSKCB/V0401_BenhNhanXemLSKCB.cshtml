<style>

    .modal-body-scroll {
        max-height: 78vh; 
        overflow-y: auto;
    }

    .master-info {
        background-color: #f8f9fa;
        border-radius: 5px;
        padding: 15px;
        margin-bottom: 15px;
        border: 1px solid #dee2e6;
    }

    .scrollable-detail {
        
        max-height: 40vh; 
        overflow-y: auto;
        border: 1px solid #dee2e6; 
        border-radius: 5px;
    }

    
        .scrollable-detail table thead {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #f8f9fa; 
        }
</style>

<div>
    <div class="container mt-5">
        <h2>Tra Cứu Lịch Sử Khám Chữa Bệnh (LSKCB)</h2>

        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label for="idBenhNhanInput" class="form-label">ID Bệnh Nhân:</label>
                <input type="number" class="form-control" id="idBenhNhanInput" placeholder="Nhập ID" value="1">
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary" id="btnXemLSKCB">
                    <i class="fas fa-search"></i> Xem Lịch Sử Khám Chữa Bệnh
                </button>
            </div>
            <div class="col-12 mt-3">
                <div id="loadingIndicator" class="spinner-border text-primary d-none" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div id="alertMessage" class="alert d-none" role="alert"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="LSKCBModal" tabindex="-1" aria-labelledby="LSKCBModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="LSKCBModalLabel">Lịch sử khám chữa bệnh</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body modal-body-scroll">
                    <div id="lskcbContent">
                        <p class="text-center text-muted">Vui lòng nhập ID bệnh nhân và nhấn nút để xem lịch sử.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/dist/js/J0401/J0401_BenhNhanXemLSKCB.js" asp-append-version="true" defer></script>

}